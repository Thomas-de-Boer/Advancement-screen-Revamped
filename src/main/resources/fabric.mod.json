{
	"schemaVersion": 1,
	"id": "advancement-screen-revamped",
	"version": "${version}",
	"name": "Advancement screen Revamped",
	"description": "A client-side replacement for the advancements screen with search, filters and a detailed view of which criteria you have completed and which are still missing. Works with BACAP.",
	"authors": [
		"Gify44"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/advancements-tracker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.advancementstracker.client.AdvancementsTrackerClient"
		]
	},
	"mixins": [
		{
			"config": "advancements-tracker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}